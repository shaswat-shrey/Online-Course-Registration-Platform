# Root .env for `docker compose --profile app` (production-mode containers).
# Copy to .env and replace every value. Generate secrets with: openssl rand -base64 48
# Compose refuses to start the app profile while a required secret is missing.
POSTGRES_PASSWORD=
STORAGE_SIGNING_SECRET=
JWT_ACCESS_SECRET=
MFA_ENCRYPTION_KEY=
# Public origin users open (behind your TLS proxy), e.g. https://register.university.edu
PUBLIC_URL=http://localhost:8080
# Outgoing mail (defaults to the bundled Mailpit catcher on :8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=UCRAMS <no-reply@ucrams.local>
