# ---------------------------------------------------------------------------
# UCRAMS API configuration. Copy to .env and adjust.
# Every variable is validated at startup (src/config/env.ts); the process exits
# on invalid configuration. Example values are for LOCAL DEVELOPMENT ONLY and
# are rejected when NODE_ENV=production.
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (1 behind Nginx).
TRUST_PROXY=0

# PostgreSQL. Docker Compose and the native setup both use these credentials.
DATABASE_URL=postgresql://ucrams:ucrams_dev_password@localhost:5432/ucrams_dev?schema=public
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
API_DOCS_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# Object storage: "local" (filesystem, dev only) or "s3" (MinIO/S3/R2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# >= 32 chars. Signs local-storage URLs. Generate: openssl rand -base64 48
STORAGE_SIGNING_SECRET=change-me-change-me-change-me-change-me
PUBLIC_API_URL=http://localhost:4000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ucrams
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email: "log" (render and log only) or "smtp" (e.g. Mailpit on 1025).
MAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UCRAMS <no-reply@ucrams.local>"
