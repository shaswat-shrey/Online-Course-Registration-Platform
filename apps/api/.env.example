# ---------------------------------------------------------------------------
# UCRAMS API configuration. Copy to .env and adjust.
# Every variable is validated at startup (src/config/env.ts); the process exits
# on invalid configuration. Example values are for LOCAL DEVELOPMENT ONLY and
# are rejected when NODE_ENV=production.
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (1 behind Nginx).
TRUST_PROXY=0

# PostgreSQL. Docker Compose and the native setup both use these credentials.
DATABASE_URL=postgresql://ucrams:ucrams_dev_password@localhost:5432/ucrams_dev?schema=public
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
API_DOCS_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# Object storage: "local" (filesystem, dev only) or "s3" (MinIO/S3/R2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# >= 32 chars. Signs local-storage URLs. Generate: openssl rand -base64 48
STORAGE_SIGNING_SECRET=change-me-change-me-change-me-change-me
# Base URL for links the API generates (signed file URLs). In development this is the
# web origin: the Vite proxy serves /api, keeping images same-origin.
PUBLIC_API_URL=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ucrams
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Authentication. JWT secret >= 32 chars: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-jwt-change-me-jwt-change-me-jwt
# >= 32 chars. Encrypts two-factor secrets at rest: openssl rand -base64 48
MFA_ENCRYPTION_KEY=change-me-mfa-change-me-mfa-change-me-mfa
# JWT_ACCESS_SECRET_PREVIOUS=   # set to the old secret while rotating keys
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
REFRESH_REMEMBER_TTL_DAYS=30
# Secure cookies default to true in production, false otherwise (plain-HTTP dev).
# COOKIE_SECURE=false
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_MINUTES=15
WEB_APP_URL=http://localhost:5173

# Development seed only: password for the per-role dev accounts (never used in production).
SEED_DEV_PASSWORD=Ucrams-Dev-Pass-2026

# Email: "log" (render and log only) or "smtp" (e.g. Mailpit on 1025).
MAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UCRAMS <no-reply@ucrams.local>"
