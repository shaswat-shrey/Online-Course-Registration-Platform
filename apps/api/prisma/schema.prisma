// UCRAMS database schema. Design reference: docs/DATABASE.md
// Conventions: PascalCase models mapped to snake_case tables; UUID primary keys;
// timestamptz everywhere; RESTRICT on delete unless documented otherwise.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Single-tenant: exactly one row (SRS A-01).
model University {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(200)
  shortName    String   @map("short_name") @db.VarChar(50)
  /// IANA time zone used to interpret deadlines (SRS A-05).
  timezone     String   @default("UTC") @db.VarChar(64)
  website      String?  @db.VarChar(255)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(50)
  address      String?  @db.VarChar(500)
  /// Label shown for School org units ("Faculty" or "School"), ADR-003.
  schoolLabel  String   @default("Faculty") @map("school_label") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("universities")
}

// ---------------------------------------------------------------------------
// Identity and access (DATABASE.md §3.1, USER_ROLES_AND_PERMISSIONS.md)
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ScopeType {
  GLOBAL
  SCHOOL
  DEPARTMENT
}

/// ORGANIZATIONAL roles grant powers over a scope (university/school/department).
/// RELATIONSHIP roles (faculty, student) grant powers only over the holder's own
/// sections and records; their grants never cover an organisational scope (ADR-014).
enum RoleScopeMode {
  ORGANIZATIONAL
  RELATIONSHIP
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  UNKNOWN_USER
  LOCKED
  INACTIVE
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique @db.Citext
  /// Argon2id hash; null until an invited user sets a password.
  passwordHash       String?    @map("password_hash")
  firstName          String     @map("first_name") @db.VarChar(100)
  lastName           String     @map("last_name") @db.VarChar(100)
  status             UserStatus @default(INVITED)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  /// Number of lockouts since the last successful login (drives exponential lock duration).
  lockoutCount       Int        @default(0) @map("lockout_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Incremented whenever roles/permissions change; stale access tokens are forced to refresh.
  permissionsVersion Int        @default(1) @map("permissions_version")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         UserRole[]     @relation("UserRoles")
  rolesAssigned UserRole[]     @relation("RoleAssigner")
  sessions      Session[]
  authTokens    AuthToken[]
  loginAttempts LoginAttempt[]
  auditLogs     AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String        @id @default(uuid(7)) @db.Uuid
  key         String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(500)
  /// System roles cannot be deleted; only SUPER_ADMIN may edit their permissions.
  isSystem    Boolean       @default(false) @map("is_system")
  scopeMode   RoleScopeMode @default(ORGANIZATIONAL) @map("scope_mode")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(80)
  resource    String @db.VarChar(50)
  action      String @db.VarChar(50)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Scoped role assignment. scope_id references a school or department depending on
/// scope_type (polymorphic, validated in the service). Uniqueness with NULL scope is
/// enforced by a raw-SQL NULLS NOT DISTINCT index.
model UserRole {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(GLOBAL) @map("scope_type")
  scopeId      String?   @map("scope_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id])
  role       Role  @relation(fields: [roleId], references: [id])
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  deviceLabel  String?   @map("device_label") @db.VarChar(120)
  rememberMe   Boolean   @default(false) @map("remember_me")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason") @db.VarChar(50)

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens; only SHA-256 hashes are stored (FR-AUTH-005).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Single-use hashed tokens for invitations/email verification and password resets.
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash Bytes         @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("auth_tokens")
}

/// Login history (FR-AUTH-012). Unknown identifiers are not stored in clear text.
model LoginAttempt {
  id        BigInt       @id @default(autoincrement())
  userId    String?      @map("user_id") @db.Uuid
  outcome   LoginOutcome
  ip        String?      @db.VarChar(45)
  userAgent String?      @map("user_agent") @db.VarChar(500)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// Append-only audit trail (FR-AUDIT-*). No update/delete API exists.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// Changed fields only, sensitive values redacted: { field: { from, to } } or event metadata.
  changes    Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// University structure (DATABASE.md §3.3). Heads/deans (faculty members) and
// requirement course lists are added with the faculty and course modules.
// ---------------------------------------------------------------------------

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DegreeLevel {
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORAL
}

enum CourseCategory {
  CORE
  ELECTIVE
  GENERAL_EDUCATION
  LABORATORY
  SEMINAR
  RESEARCH
  PROJECT
  INTERNSHIP
  PRACTICAL
}

enum RequirementKind {
  /// Every listed course is required (course list added with the course module).
  ALL_OF
  /// Earn min_credits from the listed courses.
  CREDITS_FROM_LIST
  /// Earn min_credits from courses of one category.
  CREDITS_FROM_CATEGORY
  /// Earn min_credits from any course (open electives).
  CREDITS_ANY
}

model Campus {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique @db.VarChar(20)
  name      String       @db.VarChar(150)
  address   String?      @db.VarChar(500)
  city      String?      @db.VarChar(100)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  schools     School[]
  departments Department[]

  @@map("campuses")
}

/// "Faculty / School" organisational unit (ADR-003).
model School {
  id           String       @id @default(uuid(7)) @db.Uuid
  code         String       @unique @db.VarChar(20)
  name         String       @db.VarChar(150)
  description  String?      @db.VarChar(2000)
  campusId     String?      @map("campus_id") @db.Uuid
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  contactPhone String?      @map("contact_phone") @db.VarChar(50)
  website      String?      @db.VarChar(255)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  campus      Campus?      @relation(fields: [campusId], references: [id])
  departments Department[]

  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "schools_name_trgm")
  @@map("schools")
}

model Department {
  id             String       @id @default(uuid(7)) @db.Uuid
  code           String       @unique @db.VarChar(20)
  name           String       @db.VarChar(150)
  description    String?      @db.VarChar(2000)
  schoolId       String       @map("school_id") @db.Uuid
  campusId       String?      @map("campus_id") @db.Uuid
  contactEmail   String?      @map("contact_email") @db.VarChar(255)
  contactPhone   String?      @map("contact_phone") @db.VarChar(50)
  officeLocation String?      @map("office_location") @db.VarChar(200)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  school   School    @relation(fields: [schoolId], references: [id])
  campus   Campus?   @relation(fields: [campusId], references: [id])
  programs Program[]

  @@index([schoolId, status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "departments_name_trgm")
  @@map("departments")
}

/// Credential type (B.Tech, B.Sc., LL.B., Ph.D.).
model Degree {
  id          String       @id @default(uuid(7)) @db.Uuid
  code        String       @unique @db.VarChar(20)
  name        String       @db.VarChar(150)
  level       DegreeLevel
  description String?      @db.VarChar(2000)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  programs Program[]

  @@map("degrees")
}

/// A degree offered by a department, e.g. "B.Tech in Computer Science".
model Program {
  id                 String       @id @default(uuid(7)) @db.Uuid
  code               String       @unique @db.VarChar(30)
  name               String       @db.VarChar(200)
  description        String?      @db.VarChar(2000)
  degreeId           String       @map("degree_id") @db.Uuid
  departmentId       String       @map("department_id") @db.Uuid
  durationYears      Decimal      @map("duration_years") @db.Decimal(3, 1)
  sessionCount       Int          @map("session_count") @db.SmallInt
  totalCredits       Decimal      @map("total_credits") @db.Decimal(5, 1)
  minCoreCredits     Decimal?     @map("min_core_credits") @db.Decimal(5, 1)
  minElectiveCredits Decimal?     @map("min_elective_credits") @db.Decimal(5, 1)
  status             EntityStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  degree            Degree             @relation(fields: [degreeId], references: [id])
  department        Department         @relation(fields: [departmentId], references: [id])
  specializations   Specialization[]
  requirementGroups RequirementGroup[]
  priorityWindows   PriorityWindow[]

  @@index([departmentId, status])
  @@index([degreeId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "programs_name_trgm")
  @@map("programs")
}

model Specialization {
  id                String       @id @default(uuid(7)) @db.Uuid
  programId         String       @map("program_id") @db.Uuid
  code              String       @db.VarChar(30)
  name              String       @db.VarChar(200)
  description       String?      @db.VarChar(2000)
  /// Credits required on top of the program's own requirements.
  additionalCredits Decimal?     @map("additional_credits") @db.Decimal(5, 1)
  status            EntityStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  program           Program            @relation(fields: [programId], references: [id])
  requirementGroups RequirementGroup[]

  @@unique([programId, code])
  @@index([programId, status])
  @@map("specializations")
}

/// Requirement block of a program or a specialization (exactly one, CHECK in SQL).
model RequirementGroup {
  id               String          @id @default(uuid(7)) @db.Uuid
  programId        String?         @map("program_id") @db.Uuid
  specializationId String?         @map("specialization_id") @db.Uuid
  name             String          @db.VarChar(150)
  description      String?         @db.VarChar(1000)
  kind             RequirementKind
  minCredits       Decimal?        @map("min_credits") @db.Decimal(5, 1)
  category         CourseCategory?
  position         Int             @default(0) @db.SmallInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  program        Program?        @relation(fields: [programId], references: [id], onDelete: Cascade)
  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([specializationId])
  @@map("requirement_groups")
}

// ---------------------------------------------------------------------------
// Academic calendar (DATABASE.md §3.4)
// ---------------------------------------------------------------------------

enum SessionType {
  FALL
  SPRING
  SUMMER
  WINTER
  TRIMESTER_1
  TRIMESTER_2
  TRIMESTER_3
  CUSTOM
}

enum SessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ApprovalMode {
  NONE
  ALL
  CROSS_DEPARTMENT
  LATE_ONLY
}

enum WaitlistPromotionMode {
  AUTO_ENROLL
  OFFER
}

model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String   @unique @db.VarChar(20)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions AcademicSession[]

  @@map("academic_years")
}

/// A term/semester within an academic year.
model AcademicSession {
  id             String        @id @default(uuid(7)) @db.Uuid
  academicYearId String        @map("academic_year_id") @db.Uuid
  code           String        @unique @db.VarChar(30)
  name           String        @db.VarChar(100)
  type           SessionType
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  status         SessionStatus @default(PLANNED)
  /// At most one current session per type (partial unique index in SQL).
  isCurrent      Boolean       @default(false) @map("is_current")
  gradingScaleId String?       @map("grading_scale_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  gradingScale       GradingScale?       @relation(fields: [gradingScaleId], references: [id])
  policy             SessionPolicy?
  registrationPeriod RegistrationPeriod?

  @@index([academicYearId])
  @@index([status])
  @@map("academic_sessions")
}

/// Registration rules for one session (FR-CAL-005).
model SessionPolicy {
  sessionId                  String                @id @map("session_id") @db.Uuid
  minCredits                 Decimal               @default(0) @map("min_credits") @db.Decimal(4, 1)
  maxCredits                 Decimal               @map("max_credits") @db.Decimal(4, 1)
  maxCreditsWithOverride     Decimal?              @map("max_credits_with_override") @db.Decimal(4, 1)
  approvalMode               ApprovalMode          @default(NONE) @map("approval_mode")
  waitlistEnabled            Boolean               @default(true) @map("waitlist_enabled")
  waitlistMaxPerSection      Int?                  @map("waitlist_max_per_section")
  promotionMode              WaitlistPromotionMode @default(AUTO_ENROLL) @map("promotion_mode")
  offerWindowHours           Int                   @default(24) @map("offer_window_hours")
  countWaitlistInCredits     Boolean               @default(false) @map("count_waitlist_in_credits")
  allowInProgressPrereqs     Boolean               @default(true) @map("allow_in_progress_prereqs")
  withdrawalRequiresApproval Boolean               @default(false) @map("withdrawal_requires_approval")
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_policies")
}

/// Registration windows for one session (FR-CAL-003). Instants are UTC.
model RegistrationPeriod {
  id                 String    @id @default(uuid(7)) @db.Uuid
  sessionId          String    @unique @map("session_id") @db.Uuid
  opensAt            DateTime  @map("opens_at") @db.Timestamptz(3)
  closesAt           DateTime  @map("closes_at") @db.Timestamptz(3)
  /// Optional late-registration window after closesAt (registrations need approval).
  lateClosesAt       DateTime? @map("late_closes_at") @db.Timestamptz(3)
  addDropDeadline    DateTime  @map("add_drop_deadline") @db.Timestamptz(3)
  withdrawalDeadline DateTime  @map("withdrawal_deadline") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  session         AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  priorityWindows PriorityWindow[]

  @@map("registration_periods")
}

/// Earlier opening for a cohort (FR-CAL-004). At least one criterion is set (CHECK).
model PriorityWindow {
  id          String   @id @default(uuid(7)) @db.Uuid
  periodId    String   @map("period_id") @db.Uuid
  name        String   @db.VarChar(100)
  opensAt     DateTime @map("opens_at") @db.Timestamptz(3)
  programId   String?  @map("program_id") @db.Uuid
  yearOfStudy Int?     @map("year_of_study") @db.SmallInt
  cohort      String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period  RegistrationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  program Program?           @relation(fields: [programId], references: [id])

  @@index([periodId])
  @@map("priority_windows")
}

/// Configurable grading scale (FR-ACAD-005). No default policy is assumed.
model GradingScale {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(1000)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries  GradeScaleEntry[]
  sessions AcademicSession[]

  @@map("grading_scales")
}

model GradeScaleEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  scaleId     String   @map("scale_id") @db.Uuid
  letter      String   @db.VarChar(5)
  minPercent  Decimal  @map("min_percent") @db.Decimal(5, 2)
  /// Null when the scale has no grade points (pass/fail scales): GPA is not computed.
  gradePoints Decimal? @map("grade_points") @db.Decimal(4, 2)
  isPassing   Boolean  @map("is_passing")
  countsInGpa Boolean  @default(true) @map("counts_in_gpa")
  position    Int      @db.SmallInt

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, letter])
  @@map("grade_scale_entries")
}
