// UCRAMS database schema. Design reference: docs/DATABASE.md
// Conventions: PascalCase models mapped to snake_case tables; UUID primary keys;
// timestamptz everywhere; RESTRICT on delete unless documented otherwise.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Single-tenant: exactly one row (SRS A-01).
model University {
  id              String          @id @default(uuid(7)) @db.Uuid
  name            String          @db.VarChar(200)
  shortName       String          @map("short_name") @db.VarChar(50)
  /// IANA time zone used to interpret deadlines (SRS A-05).
  timezone        String          @default("UTC") @db.VarChar(64)
  website         String?         @db.VarChar(255)
  contactEmail    String?         @map("contact_email") @db.VarChar(255)
  contactPhone    String?         @map("contact_phone") @db.VarChar(50)
  address         String?         @db.VarChar(500)
  /// Label shown for School org units ("Faculty" or "School"), ADR-003.
  schoolLabel     String          @default("Faculty") @map("school_label") @db.VarChar(30)
  /// How repeated courses count towards the cumulative GPA (FR-ACAD-008).
  gpaRepeatPolicy GpaRepeatPolicy @default(ALL) @map("gpa_repeat_policy")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("universities")
}

// ---------------------------------------------------------------------------
// Identity and access (DATABASE.md §3.1, USER_ROLES_AND_PERMISSIONS.md)
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ScopeType {
  GLOBAL
  SCHOOL
  DEPARTMENT
}

/// ORGANIZATIONAL roles grant powers over a scope (university/school/department).
/// RELATIONSHIP roles (faculty, student) grant powers only over the holder's own
/// sections and records; their grants never cover an organisational scope (ADR-014).
enum RoleScopeMode {
  ORGANIZATIONAL
  RELATIONSHIP
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  UNKNOWN_USER
  LOCKED
  INACTIVE
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique @db.Citext
  /// Argon2id hash; null until an invited user sets a password.
  passwordHash       String?    @map("password_hash")
  firstName          String     @map("first_name") @db.VarChar(100)
  lastName           String     @map("last_name") @db.VarChar(100)
  status             UserStatus @default(INVITED)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  /// Number of lockouts since the last successful login (drives exponential lock duration).
  lockoutCount       Int        @default(0) @map("lockout_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Incremented whenever roles/permissions change; stale access tokens are forced to refresh.
  permissionsVersion Int        @default(1) @map("permissions_version")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles          UserRole[]              @relation("UserRoles")
  rolesAssigned  UserRole[]              @relation("RoleAssigner")
  sessions       Session[]
  authTokens     AuthToken[]
  loginAttempts  LoginAttempt[]
  auditLogs      AuditLog[]
  /// Profile photo (stored file with context AVATAR).
  avatarFileId   String?                 @map("avatar_file_id") @db.Uuid
  avatar         StoredFile?             @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles  StoredFile[]            @relation("FileOwner")
  student        Student?
  facultyMember  FacultyMember?
  adminProfile   AdminProfile?
  holdsPlaced    RegistrationHold[]      @relation("HoldPlacedBy")
  holdsReleased  RegistrationHold[]      @relation("HoldReleasedBy")
  programChanges StudentProgramHistory[]
  importJobs     ImportJob[]

  notifications         Notification[]
  registrationEvents    RegistrationEvent[]
  registrationDecisions RegistrationRequest[] @relation("RequestDecider")

  materialsCreated SectionMaterial[]
  announcements    Announcement[]

  announcementReads       AnnouncementRead[]
  conversationsCreated    Conversation[]            @relation("ConversationCreator")
  supportConversation     Conversation?             @relation("SupportOwner")
  conversationMemberships ConversationParticipant[]
  messagesSent            Message[]
  discussionThreads       DiscussionThread[]
  discussionPosts         DiscussionPost[]
  notificationPreferences NotificationPreference[]
  feedbackSubmitted       Feedback[]                @relation("FeedbackSubmitter")
  feedbackAssigned        Feedback[]                @relation("FeedbackAssignee")
  feedbackResponses       FeedbackResponse[]
  ticketsOwned            SupportTicket[]           @relation("TicketOwner")
  ticketsAssigned         SupportTicket[]           @relation("TicketAssignee")
  ticketResponses         TicketResponse[]
  ticketEvents            TicketEvent[]

  attendanceSessionsCreated AttendanceSession[]
  gradeSubmissionsSubmitted FinalGradeSubmission[] @relation("GradeSubmitter")
  gradeSubmissionsDecided   FinalGradeSubmission[] @relation("GradeDecider")
  gradeChangesMade          GradeChange[]
  exportJobs                ExportJob[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String        @id @default(uuid(7)) @db.Uuid
  key         String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(500)
  /// System roles cannot be deleted; only SUPER_ADMIN may edit their permissions.
  isSystem    Boolean       @default(false) @map("is_system")
  scopeMode   RoleScopeMode @default(ORGANIZATIONAL) @map("scope_mode")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(80)
  resource    String @db.VarChar(50)
  action      String @db.VarChar(50)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Scoped role assignment. scope_id references a school or department depending on
/// scope_type (polymorphic, validated in the service). Uniqueness with NULL scope is
/// enforced by a raw-SQL NULLS NOT DISTINCT index.
model UserRole {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(GLOBAL) @map("scope_type")
  scopeId      String?   @map("scope_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id])
  role       Role  @relation(fields: [roleId], references: [id])
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  deviceLabel  String?   @map("device_label") @db.VarChar(120)
  rememberMe   Boolean   @default(false) @map("remember_me")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason") @db.VarChar(50)

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens; only SHA-256 hashes are stored (FR-AUTH-005).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Single-use hashed tokens for invitations/email verification and password resets.
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash Bytes         @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("auth_tokens")
}

/// Login history (FR-AUTH-012). Unknown identifiers are not stored in clear text.
model LoginAttempt {
  id        BigInt       @id @default(autoincrement())
  userId    String?      @map("user_id") @db.Uuid
  outcome   LoginOutcome
  ip        String?      @db.VarChar(45)
  userAgent String?      @map("user_agent") @db.VarChar(500)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// Append-only audit trail (FR-AUDIT-*). No update/delete API exists.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// Changed fields only, sensitive values redacted: { field: { from, to } } or event metadata.
  changes    Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// University structure (DATABASE.md §3.3). Heads/deans (faculty members) and
// requirement course lists are added with the faculty and course modules.
// ---------------------------------------------------------------------------

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DegreeLevel {
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORAL
}

enum CourseCategory {
  CORE
  ELECTIVE
  GENERAL_EDUCATION
  LABORATORY
  SEMINAR
  RESEARCH
  PROJECT
  INTERNSHIP
  PRACTICAL
}

enum RequirementKind {
  /// Every listed course is required (course list added with the course module).
  ALL_OF
  /// Earn min_credits from the listed courses.
  CREDITS_FROM_LIST
  /// Earn min_credits from courses of one category.
  CREDITS_FROM_CATEGORY
  /// Earn min_credits from any course (open electives).
  CREDITS_ANY
}

model Campus {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique @db.VarChar(20)
  name      String       @db.VarChar(150)
  address   String?      @db.VarChar(500)
  city      String?      @db.VarChar(100)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  schools     School[]
  departments Department[]

  classrooms Classroom[]
  sections   CourseSection[]

  @@map("campuses")
}

/// "Faculty / School" organisational unit (ADR-003).
model School {
  id           String       @id @default(uuid(7)) @db.Uuid
  code         String       @unique @db.VarChar(20)
  name         String       @db.VarChar(150)
  description  String?      @db.VarChar(2000)
  campusId     String?      @map("campus_id") @db.Uuid
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  contactPhone String?      @map("contact_phone") @db.VarChar(50)
  website      String?      @db.VarChar(255)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  campus      Campus?        @relation(fields: [campusId], references: [id])
  departments Department[]
  /// Dean: a faculty member of one of the school's departments.
  deanId      String?        @map("dean_id") @db.Uuid
  dean        FacultyMember? @relation("SchoolDean", fields: [deanId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "schools_name_trgm")
  @@map("schools")
}

model Department {
  id             String       @id @default(uuid(7)) @db.Uuid
  code           String       @unique @db.VarChar(20)
  name           String       @db.VarChar(150)
  description    String?      @db.VarChar(2000)
  schoolId       String       @map("school_id") @db.Uuid
  campusId       String?      @map("campus_id") @db.Uuid
  contactEmail   String?      @map("contact_email") @db.VarChar(255)
  contactPhone   String?      @map("contact_phone") @db.VarChar(50)
  officeLocation String?      @map("office_location") @db.VarChar(200)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  school           School                       @relation(fields: [schoolId], references: [id])
  campus           Campus?                      @relation(fields: [campusId], references: [id])
  programs         Program[]
  /// Head of department: a faculty member of this department.
  headId           String?                      @map("head_id") @db.Uuid
  head             FacultyMember?               @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  facultyMembers   FacultyMember[]              @relation("FacultyPrimaryDepartment")
  secondaryFaculty FacultySecondaryDepartment[]
  adminProfiles    AdminProfile[]

  courses Course[]

  feedback Feedback[]
  tickets  SupportTicket[]

  @@index([schoolId, status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "departments_name_trgm")
  @@map("departments")
}

/// Credential type (B.Tech, B.Sc., LL.B., Ph.D.).
model Degree {
  id          String       @id @default(uuid(7)) @db.Uuid
  code        String       @unique @db.VarChar(20)
  name        String       @db.VarChar(150)
  level       DegreeLevel
  description String?      @db.VarChar(2000)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  programs Program[]

  @@map("degrees")
}

/// A degree offered by a department, e.g. "B.Tech in Computer Science".
model Program {
  id                 String       @id @default(uuid(7)) @db.Uuid
  code               String       @unique @db.VarChar(30)
  name               String       @db.VarChar(200)
  description        String?      @db.VarChar(2000)
  degreeId           String       @map("degree_id") @db.Uuid
  departmentId       String       @map("department_id") @db.Uuid
  durationYears      Decimal      @map("duration_years") @db.Decimal(3, 1)
  sessionCount       Int          @map("session_count") @db.SmallInt
  totalCredits       Decimal      @map("total_credits") @db.Decimal(5, 1)
  minCoreCredits     Decimal?     @map("min_core_credits") @db.Decimal(5, 1)
  minElectiveCredits Decimal?     @map("min_elective_credits") @db.Decimal(5, 1)
  status             EntityStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  degree            Degree                  @relation(fields: [degreeId], references: [id])
  department        Department              @relation(fields: [departmentId], references: [id])
  specializations   Specialization[]
  requirementGroups RequirementGroup[]
  priorityWindows   PriorityWindow[]
  students          Student[]
  historyFrom       StudentProgramHistory[] @relation("HistoryFromProgram")
  historyTo         StudentProgramHistory[] @relation("HistoryToProgram")

  courseMappings CourseProgram[]

  @@index([departmentId, status])
  @@index([degreeId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "programs_name_trgm")
  @@map("programs")
}

model Specialization {
  id                String       @id @default(uuid(7)) @db.Uuid
  programId         String       @map("program_id") @db.Uuid
  code              String       @db.VarChar(30)
  name              String       @db.VarChar(200)
  description       String?      @db.VarChar(2000)
  /// Credits required on top of the program's own requirements.
  additionalCredits Decimal?     @map("additional_credits") @db.Decimal(5, 1)
  status            EntityStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  program           Program            @relation(fields: [programId], references: [id])
  requirementGroups RequirementGroup[]
  students          Student[]

  courseMappings CourseSpecialization[]

  @@unique([programId, code])
  @@index([programId, status])
  @@map("specializations")
}

/// Requirement block of a program or a specialization (exactly one, CHECK in SQL).
model RequirementGroup {
  id               String          @id @default(uuid(7)) @db.Uuid
  programId        String?         @map("program_id") @db.Uuid
  specializationId String?         @map("specialization_id") @db.Uuid
  name             String          @db.VarChar(150)
  description      String?         @db.VarChar(1000)
  kind             RequirementKind
  minCredits       Decimal?        @map("min_credits") @db.Decimal(5, 1)
  category         CourseCategory?
  position         Int             @default(0) @db.SmallInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  program        Program?        @relation(fields: [programId], references: [id], onDelete: Cascade)
  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  courses RequirementCourse[]

  @@index([programId])
  @@index([specializationId])
  @@map("requirement_groups")
}

// ---------------------------------------------------------------------------
// Academic calendar (DATABASE.md §3.4)
// ---------------------------------------------------------------------------

enum SessionType {
  FALL
  SPRING
  SUMMER
  WINTER
  TRIMESTER_1
  TRIMESTER_2
  TRIMESTER_3
  CUSTOM
}

enum SessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ApprovalMode {
  NONE
  ALL
  CROSS_DEPARTMENT
  LATE_ONLY
}

enum WaitlistPromotionMode {
  AUTO_ENROLL
  OFFER
}

model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String   @unique @db.VarChar(20)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions AcademicSession[]

  @@map("academic_years")
}

/// A term/semester within an academic year.
model AcademicSession {
  id             String        @id @default(uuid(7)) @db.Uuid
  academicYearId String        @map("academic_year_id") @db.Uuid
  code           String        @unique @db.VarChar(30)
  name           String        @db.VarChar(100)
  type           SessionType
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  status         SessionStatus @default(PLANNED)
  /// At most one current session per type (partial unique index in SQL).
  isCurrent      Boolean       @default(false) @map("is_current")
  gradingScaleId String?       @map("grading_scale_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear       AcademicYear            @relation(fields: [academicYearId], references: [id])
  gradingScale       GradingScale?           @relation(fields: [gradingScaleId], references: [id])
  policy             SessionPolicy?
  registrationPeriod RegistrationPeriod?
  admittedStudents   Student[]               @relation("AdmissionSession")
  programChanges     StudentProgramHistory[]

  sections CourseSection[]

  registrations   CourseRegistration[]
  academicRecords AcademicRecord[]
  coursePlans     CoursePlan[]

  attendance       AttendanceRecord[]
  assessmentScores AssessmentScore[]

  @@index([academicYearId])
  @@index([status])
  @@map("academic_sessions")
}

/// Registration rules for one session (FR-CAL-005).
model SessionPolicy {
  sessionId                  String                @id @map("session_id") @db.Uuid
  minCredits                 Decimal               @default(0) @map("min_credits") @db.Decimal(4, 1)
  maxCredits                 Decimal               @map("max_credits") @db.Decimal(4, 1)
  maxCreditsWithOverride     Decimal?              @map("max_credits_with_override") @db.Decimal(4, 1)
  approvalMode               ApprovalMode          @default(NONE) @map("approval_mode")
  waitlistEnabled            Boolean               @default(true) @map("waitlist_enabled")
  waitlistMaxPerSection      Int?                  @map("waitlist_max_per_section")
  promotionMode              WaitlistPromotionMode @default(AUTO_ENROLL) @map("promotion_mode")
  offerWindowHours           Int                   @default(24) @map("offer_window_hours")
  countWaitlistInCredits     Boolean               @default(false) @map("count_waitlist_in_credits")
  allowInProgressPrereqs     Boolean               @default(true) @map("allow_in_progress_prereqs")
  withdrawalRequiresApproval Boolean               @default(false) @map("withdrawal_requires_approval")
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_policies")
}

/// Registration windows for one session (FR-CAL-003). Instants are UTC.
model RegistrationPeriod {
  id                 String    @id @default(uuid(7)) @db.Uuid
  sessionId          String    @unique @map("session_id") @db.Uuid
  opensAt            DateTime  @map("opens_at") @db.Timestamptz(3)
  closesAt           DateTime  @map("closes_at") @db.Timestamptz(3)
  /// Optional late-registration window after closesAt (registrations need approval).
  lateClosesAt       DateTime? @map("late_closes_at") @db.Timestamptz(3)
  addDropDeadline    DateTime  @map("add_drop_deadline") @db.Timestamptz(3)
  withdrawalDeadline DateTime  @map("withdrawal_deadline") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  session         AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  priorityWindows PriorityWindow[]

  @@map("registration_periods")
}

/// Earlier opening for a cohort (FR-CAL-004). At least one criterion is set (CHECK).
model PriorityWindow {
  id          String   @id @default(uuid(7)) @db.Uuid
  periodId    String   @map("period_id") @db.Uuid
  name        String   @db.VarChar(100)
  opensAt     DateTime @map("opens_at") @db.Timestamptz(3)
  programId   String?  @map("program_id") @db.Uuid
  yearOfStudy Int?     @map("year_of_study") @db.SmallInt
  cohort      String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period  RegistrationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  program Program?           @relation(fields: [programId], references: [id])

  @@index([periodId])
  @@map("priority_windows")
}

/// Configurable grading scale (FR-ACAD-005). No default policy is assumed.
model GradingScale {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(1000)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries  GradeScaleEntry[]
  sessions AcademicSession[]

  @@map("grading_scales")
}

model GradeScaleEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  scaleId     String   @map("scale_id") @db.Uuid
  letter      String   @db.VarChar(5)
  minPercent  Decimal  @map("min_percent") @db.Decimal(5, 2)
  /// Null when the scale has no grade points (pass/fail scales): GPA is not computed.
  gradePoints Decimal? @map("grade_points") @db.Decimal(4, 2)
  isPassing   Boolean  @map("is_passing")
  countsInGpa Boolean  @default(true) @map("counts_in_gpa")
  position    Int      @db.SmallInt

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, letter])
  @@map("grade_scale_entries")
}

// ---------------------------------------------------------------------------
// People (DATABASE.md §3.2)
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  DISMISSED
}

enum FacultyDesignation {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  ASSISTANT_PROFESSOR
  LECTURER
  SENIOR_LECTURER
  ADJUNCT
  VISITING
  EMERITUS
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum HoldType {
  FINANCIAL
  ACADEMIC
  DISCIPLINARY
  ADMINISTRATIVE
  DOCUMENTATION
}

model Student {
  id                     String        @id @default(uuid(7)) @db.Uuid
  userId                 String        @unique @map("user_id") @db.Uuid
  studentNumber          String        @unique @map("student_number") @db.VarChar(30)
  programId              String        @map("program_id") @db.Uuid
  /// Must belong to the program (enforced by trigger + service).
  specializationId       String?       @map("specialization_id") @db.Uuid
  admissionSessionId     String?       @map("admission_session_id") @db.Uuid
  admissionDate          DateTime?     @map("admission_date") @db.Date
  expectedGraduationYear Int?          @map("expected_graduation_year") @db.SmallInt
  yearOfStudy            Int           @default(1) @map("year_of_study") @db.SmallInt
  cohort                 String?       @db.VarChar(50)
  status                 StudentStatus @default(ACTIVE)
  /// Contact phone students may edit; sensitive details live in student_contacts.
  phone                  String?       @db.VarChar(50)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                    @relation(fields: [userId], references: [id])
  program          Program                 @relation(fields: [programId], references: [id])
  specialization   Specialization?         @relation(fields: [specializationId], references: [id])
  admissionSession AcademicSession?        @relation("AdmissionSession", fields: [admissionSessionId], references: [id])
  contact          StudentContact?
  holds            RegistrationHold[]
  programHistory   StudentProgramHistory[]

  registrations     CourseRegistration[]
  academicRecords   AcademicRecord[]
  coursePlans       CoursePlan[]
  attendanceRecords AttendanceRecord[]
  assessmentScores  AssessmentScore[]

  @@index([programId, status])
  @@index([status])
  @@map("students")
}

/// Sensitive personal data, separated for access control (student:read_sensitive).
model StudentContact {
  studentId                String    @id @map("student_id") @db.Uuid
  personalEmail            String?   @map("personal_email") @db.VarChar(255)
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  addressLine              String?   @map("address_line") @db.VarChar(300)
  city                     String?   @db.VarChar(100)
  state                    String?   @db.VarChar(100)
  postalCode               String?   @map("postal_code") @db.VarChar(20)
  country                  String?   @db.VarChar(100)
  emergencyContactName     String?   @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone    String?   @map("emergency_contact_phone") @db.VarChar(50)
  emergencyContactRelation String?   @map("emergency_contact_relation") @db.VarChar(50)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_contacts")
}

/// Program/specialization changes (FR-USER-006, BR-011/012).
model StudentProgramHistory {
  id                   String   @id @default(uuid(7)) @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  fromProgramId        String?  @map("from_program_id") @db.Uuid
  toProgramId          String   @map("to_program_id") @db.Uuid
  fromSpecializationId String?  @map("from_specialization_id") @db.Uuid
  toSpecializationId   String?  @map("to_specialization_id") @db.Uuid
  effectiveSessionId   String?  @map("effective_session_id") @db.Uuid
  reason               String   @db.VarChar(500)
  changedById          String   @map("changed_by_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  student          Student          @relation(fields: [studentId], references: [id])
  fromProgram      Program?         @relation("HistoryFromProgram", fields: [fromProgramId], references: [id])
  toProgram        Program          @relation("HistoryToProgram", fields: [toProgramId], references: [id])
  effectiveSession AcademicSession? @relation(fields: [effectiveSessionId], references: [id])
  changedBy        User             @relation(fields: [changedById], references: [id])

  @@index([studentId, createdAt])
  @@map("student_program_history")
}

/// Holds block registration while active (FR-USER-007).
model RegistrationHold {
  id           String    @id @default(uuid(7)) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  type         HoldType
  reason       String    @db.VarChar(500)
  placedById   String    @map("placed_by_id") @db.Uuid
  placedAt     DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById String?   @map("released_by_id") @db.Uuid
  releaseNote  String?   @map("release_note") @db.VarChar(500)

  student    Student @relation(fields: [studentId], references: [id])
  placedBy   User    @relation("HoldPlacedBy", fields: [placedById], references: [id])
  releasedBy User?   @relation("HoldReleasedBy", fields: [releasedById], references: [id])

  @@index([studentId, releasedAt])
  @@map("registration_holds")
}

model FacultyMember {
  id                String             @id @default(uuid(7)) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  employeeNumber    String             @unique @map("employee_number") @db.VarChar(30)
  departmentId      String             @map("department_id") @db.Uuid
  designation       FacultyDesignation
  employmentStatus  EmploymentStatus   @default(ACTIVE) @map("employment_status")
  qualifications    String?            @db.VarChar(1000)
  specialization    String?            @db.VarChar(200)
  researchInterests String?            @map("research_interests") @db.VarChar(1000)
  officeLocation    String?            @map("office_location") @db.VarChar(200)
  officeHours       String?            @map("office_hours") @db.VarChar(300)
  phone             String?            @db.VarChar(50)
  /// Maximum teaching load per session, in credits.
  maxLoadCredits    Decimal?           @map("max_load_credits") @db.Decimal(4, 1)
  joinedOn          DateTime?          @map("joined_on") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                         @relation(fields: [userId], references: [id])
  department           Department                   @relation("FacultyPrimaryDepartment", fields: [departmentId], references: [id])
  secondaryDepartments FacultySecondaryDepartment[]
  headOf               Department[]                 @relation("DepartmentHead")
  deanOf               School[]                     @relation("SchoolDean")

  coordinatedCourses Course[]            @relation("CourseCoordinator")
  sectionAssignments SectionInstructor[]

  @@index([departmentId, employmentStatus])
  @@map("faculty_members")
}

/// Joint appointments (FR-USER-002).
model FacultySecondaryDepartment {
  facultyMemberId String @map("faculty_member_id") @db.Uuid
  departmentId    String @map("department_id") @db.Uuid

  facultyMember FacultyMember @relation(fields: [facultyMemberId], references: [id], onDelete: Cascade)
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([facultyMemberId, departmentId])
  @@index([departmentId])
  @@map("faculty_secondary_departments")
}

/// Staff details for administrators (their powers come from role assignments).
model AdminProfile {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  employeeNumber     String?  @unique @map("employee_number") @db.VarChar(30)
  jobTitle           String?  @map("job_title") @db.VarChar(150)
  officeDepartmentId String?  @map("office_department_id") @db.Uuid
  phone              String?  @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User        @relation(fields: [userId], references: [id])
  officeDepartment Department? @relation(fields: [officeDepartmentId], references: [id])

  @@map("admin_profiles")
}

/// Monotonic counters for human-readable identifiers (student numbers etc.).
model IdSequence {
  key   String @id @db.VarChar(60)
  value Int

  @@map("id_sequences")
}

// ---------------------------------------------------------------------------
// Files and imports (DATABASE.md §3.9)
// ---------------------------------------------------------------------------

enum FileContext {
  AVATAR
  MATERIAL
  SYLLABUS
  MESSAGE
  TICKET
  ANNOUNCEMENT
  DOCUMENT
  EXPORT
  IMPORT
}

enum FileStatus {
  PENDING
  READY
  REJECTED
}

/// Metadata for objects in storage; the bytes live in object storage (FR-FILE-*).
model StoredFile {
  id           String      @id @default(uuid(7)) @db.Uuid
  ownerId      String      @map("owner_id") @db.Uuid
  storageKey   String      @unique @map("storage_key") @db.VarChar(300)
  originalName String      @map("original_name") @db.VarChar(255)
  /// Declared by the client at upload; replaced by the sniffed type on completion.
  mimeType     String      @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt      @map("size_bytes")
  context      FileContext
  status       FileStatus  @default(PENDING)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime?   @map("completed_at") @db.Timestamptz(3)

  owner       User   @relation("FileOwner", fields: [ownerId], references: [id])
  avatarUsers User[] @relation("UserAvatar")

  materials         SectionMaterial[]
  messageAttachment MessageAttachment?
  ticketAttachment  TicketAttachment?
  exportJob         ExportJob?

  @@index([ownerId, context])
  @@index([status, createdAt])
  @@map("stored_files")
}

enum ImportKind {
  STUDENTS
  FACULTY
}

enum ImportStatus {
  PREVIEW
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  INVALID
  CREATED
  FAILED
}

/// Bulk import of students or faculty (FR-USER-005).
model ImportJob {
  id           String       @id @default(uuid(7)) @db.Uuid
  kind         ImportKind
  status       ImportStatus @default(PREVIEW)
  fileName     String       @map("file_name") @db.VarChar(255)
  sendInvites  Boolean      @default(true) @map("send_invites")
  totalRows    Int          @map("total_rows")
  validRows    Int          @map("valid_rows")
  createdRows  Int          @default(0) @map("created_rows")
  failedRows   Int          @default(0) @map("failed_rows")
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(3)
  errorMessage String?      @map("error_message") @db.VarChar(500)

  createdBy User           @relation(fields: [createdById], references: [id])
  rows      ImportJobRow[]

  @@index([createdById, createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id        String          @id @default(uuid(7)) @db.Uuid
  jobId     String          @map("job_id") @db.Uuid
  rowNumber Int             @map("row_number")
  /// Normalised input for this row (validated import payload, not domain data).
  data      Json
  status    ImportRowStatus
  errors    Json?
  /// The user created from this row.
  userId    String?         @map("user_id") @db.Uuid

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@map("import_job_rows")
}

// ============================================================================
// Courses, classrooms and sections (Phase 5, DATABASE.md §3.5)
// ============================================================================

enum CourseStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CourseMappingType {
  CORE
  ELECTIVE
}

enum RestrictionMode {
  INCLUDE
  EXCLUDE
}

enum RestrictionTarget {
  DEPARTMENT
  PROGRAM
  SPECIALIZATION
  YEAR_OF_STUDY
}

enum ClassroomType {
  LECTURE_HALL
  CLASSROOM
  LABORATORY
  SEMINAR_ROOM
  COMPUTER_LAB
  AUDITORIUM
  STUDIO
}

enum SectionStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
  COMPLETED
}

enum MeetingType {
  LECTURE
  LAB
  TUTORIAL
  SEMINAR
  PRACTICAL
}

enum InstructorRole {
  PRIMARY
  SECONDARY
  TA
}

model Course {
  id                     String                   @id @default(uuid(7)) @db.Uuid
  code                   String                   @unique @db.VarChar(20)
  title                  String                   @db.VarChar(200)
  description            String?                  @db.VarChar(5000)
  departmentId           String                   @map("department_id") @db.Uuid
  credits                Decimal                  @db.Decimal(4, 1)
  /// 100–900 course level.
  level                  Int                      @db.SmallInt
  category               CourseCategory
  recommendedYear        Int?                     @map("recommended_year") @db.SmallInt
  recommendedSessionType SessionType?             @map("recommended_session_type")
  syllabus               String?                  @db.Text
  defaultCapacity        Int?                     @map("default_capacity")
  minEnrollment          Int?                     @map("min_enrollment")
  coordinatorId          String?                  @map("coordinator_id") @db.Uuid
  isRepeatable           Boolean                  @default(false) @map("is_repeatable")
  status                 CourseStatus             @default(DRAFT)
  /// Generated full-text vector (raw SQL in the migration).
  searchVector           Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  department           Department                  @relation(fields: [departmentId], references: [id])
  coordinator          FacultyMember?              @relation("CourseCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  outcomes             CourseOutcome[]
  assessmentComponents CourseAssessmentComponent[]
  prerequisiteGroups   PrerequisiteGroup[]
  requiredBy           PrerequisiteItem[]          @relation("PrerequisiteRequired")
  corequisites         CourseCorequisite[]         @relation("CoreqOwner")
  corequisiteOf        CourseCorequisite[]         @relation("CoreqTarget")
  programs             CourseProgram[]
  specializations      CourseSpecialization[]
  restrictions         CourseRestriction[]
  requirementGroups    RequirementCourse[]
  sections             CourseSection[]

  registrations   CourseRegistration[]
  academicRecords AcademicRecord[]
  planItems       CoursePlanItem[]
  feedback        Feedback[]

  @@index([departmentId, status])
  @@index([searchVector], type: Gin, map: "courses_search_vector")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_title_trgm")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_code_trgm")
  @@map("courses")
}

model CourseOutcome {
  id          String @id @default(uuid(7)) @db.Uuid
  courseId    String @map("course_id") @db.Uuid
  position    Int    @db.SmallInt
  description String @db.VarChar(1000)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@map("course_outcomes")
}

model CourseAssessmentComponent {
  id       String  @id @default(uuid(7)) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  position Int     @db.SmallInt
  name     String  @db.VarChar(150)
  weight   Decimal @db.Decimal(5, 2)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@map("course_assessment_components")
}

/// AND-group of prerequisites; any one item in the group satisfies it.
model PrerequisiteGroup {
  id       String @id @default(uuid(7)) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  position Int    @db.SmallInt

  course Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  PrerequisiteItem[]

  @@index([courseId])
  @@map("prerequisite_groups")
}

model PrerequisiteItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  groupId          String  @map("group_id") @db.Uuid
  requiredCourseId String  @map("required_course_id") @db.Uuid
  minGradeLetter   String? @map("min_grade_letter") @db.VarChar(5)

  group          PrerequisiteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requiredCourse Course            @relation("PrerequisiteRequired", fields: [requiredCourseId], references: [id])

  @@unique([groupId, requiredCourseId])
  @@index([requiredCourseId])
  @@map("prerequisite_items")
}

model CourseCorequisite {
  courseId      String @map("course_id") @db.Uuid
  corequisiteId String @map("corequisite_id") @db.Uuid

  course      Course @relation("CoreqOwner", fields: [courseId], references: [id], onDelete: Cascade)
  corequisite Course @relation("CoreqTarget", fields: [corequisiteId], references: [id])

  @@id([courseId, corequisiteId])
  @@index([corequisiteId])
  @@map("course_corequisites")
}

model CourseProgram {
  courseId    String            @map("course_id") @db.Uuid
  programId   String            @map("program_id") @db.Uuid
  mappingType CourseMappingType @map("mapping_type")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([courseId, programId])
  @@index([programId])
  @@map("course_programs")
}

model CourseSpecialization {
  courseId         String            @map("course_id") @db.Uuid
  specializationId String            @map("specialization_id") @db.Uuid
  mappingType      CourseMappingType @map("mapping_type")

  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([courseId, specializationId])
  @@index([specializationId])
  @@map("course_specializations")
}

/// Include/exclude rule on a course or a section (exactly one owner, CHECK in SQL).
model CourseRestriction {
  id          String            @id @default(uuid(7)) @db.Uuid
  courseId    String?           @map("course_id") @db.Uuid
  sectionId   String?           @map("section_id") @db.Uuid
  mode        RestrictionMode
  targetType  RestrictionTarget @map("target_type")
  /// Department, program or specialization id.
  targetId    String?           @map("target_id") @db.Uuid
  /// Year of study for YEAR_OF_STUDY rules.
  targetValue Int?              @map("target_value") @db.SmallInt

  course  Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section CourseSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([sectionId])
  @@map("course_restrictions")
}

/// Courses listed in an ALL_OF / CREDITS_FROM_LIST requirement group.
model RequirementCourse {
  requirementGroupId String @map("requirement_group_id") @db.Uuid
  courseId           String @map("course_id") @db.Uuid

  requirementGroup RequirementGroup @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id])

  @@id([requirementGroupId, courseId])
  @@index([courseId])
  @@map("requirement_courses")
}

model Classroom {
  id         String        @id @default(uuid(7)) @db.Uuid
  campusId   String        @map("campus_id") @db.Uuid
  building   String        @db.VarChar(100)
  roomNumber String        @map("room_number") @db.VarChar(30)
  name       String?       @db.VarChar(150)
  capacity   Int
  type       ClassroomType
  equipment  String[]      @default([])
  status     EntityStatus  @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  campus   Campus           @relation(fields: [campusId], references: [id])
  meetings SectionMeeting[]

  @@unique([campusId, building, roomNumber])
  @@map("classrooms")
}

model CourseSection {
  id                     String        @id @default(uuid(7)) @db.Uuid
  courseId               String        @map("course_id") @db.Uuid
  sessionId              String        @map("session_id") @db.Uuid
  sectionCode            String        @map("section_code") @db.VarChar(20)
  capacity               Int
  enrolledCount          Int           @default(0) @map("enrolled_count")
  waitlistCapacity       Int           @default(0) @map("waitlist_capacity")
  waitlistCount          Int           @default(0) @map("waitlist_count")
  campusId               String?       @map("campus_id") @db.Uuid
  status                 SectionStatus @default(DRAFT)
  registrationOpen       Boolean       @default(true) @map("registration_open")
  notes                  String?       @db.VarChar(2000)
  publishedAt            DateTime?     @map("published_at") @db.Timestamptz(3)
  cancelledAt            DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason           String?       @map("cancel_reason") @db.VarChar(500)
  /// Reason given when the current schedule was saved despite conflicts; cleared once conflict-free.
  scheduleOverrideReason String?       @map("schedule_override_reason") @db.VarChar(500)
  /// Attendance tracking is enabled per section (FR-ACAD-003).
  attendanceEnabled      Boolean       @default(true) @map("attendance_enabled")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  course       Course              @relation(fields: [courseId], references: [id])
  session      AcademicSession     @relation(fields: [sessionId], references: [id])
  campus       Campus?             @relation(fields: [campusId], references: [id])
  meetings     SectionMeeting[]
  instructors  SectionInstructor[]
  restrictions CourseRestriction[]

  registrations CourseRegistration[]
  planItems     CoursePlanItem[]

  materials SectionMaterial[]

  conversation      Conversation?
  discussionThreads DiscussionThread[]

  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  gradeSubmission    FinalGradeSubmission?

  @@unique([courseId, sessionId, sectionCode])
  @@index([sessionId, status])
  @@index([courseId, sessionId])
  @@map("course_sections")
}

model SectionMeeting {
  id          String      @id @default(uuid(7)) @db.Uuid
  sectionId   String      @map("section_id") @db.Uuid
  classroomId String?     @map("classroom_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday.
  dayOfWeek   Int         @map("day_of_week") @db.SmallInt
  /// Minutes after midnight in the university time zone.
  startMinute Int         @map("start_minute") @db.SmallInt
  endMinute   Int         @map("end_minute") @db.SmallInt
  type        MeetingType @default(LECTURE)

  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classroom Classroom?    @relation(fields: [classroomId], references: [id])

  @@index([sectionId])
  @@index([classroomId, dayOfWeek])
  @@map("section_meetings")
}

model SectionInstructor {
  sectionId       String         @map("section_id") @db.Uuid
  facultyMemberId String         @map("faculty_member_id") @db.Uuid
  role            InstructorRole
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  section       CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  facultyMember FacultyMember @relation(fields: [facultyMemberId], references: [id])

  @@id([sectionId, facultyMemberId])
  @@index([facultyMemberId])
  @@map("section_instructors")
}

// ============================================================================
// Registration engine (Phase 6, DATABASE.md §3.6)
// ============================================================================

enum RegistrationStatus {
  PENDING
  REGISTERED
  WAITLISTED
  OFFERED
  DROPPED
  WITHDRAWN
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum RegistrationRequestType {
  WITHDRAWAL
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RecordSource {
  ENROLLMENT
  TRANSFER
  EXEMPTION
}

enum NotificationCategory {
  REGISTRATION
  WAITLIST
  ANNOUNCEMENT
  MESSAGE
  TICKET
  FEEDBACK
  SCHEDULE
  GRADES
  SYSTEM
}

/// One attempt by a student at a section. Seat-holding: PENDING, REGISTERED, OFFERED.
model CourseRegistration {
  id             String             @id @default(uuid(7)) @db.Uuid
  studentId      String             @map("student_id") @db.Uuid
  sectionId      String             @map("section_id") @db.Uuid
  /// Denormalised from the section for the one-active-attempt index (kept equal by a trigger).
  courseId       String             @map("course_id") @db.Uuid
  sessionId      String             @map("session_id") @db.Uuid
  status         RegistrationStatus
  /// Credits snapshot at registration time.
  credits        Decimal            @db.Decimal(4, 1)
  waitlistedAt   DateTime?          @map("waitlisted_at") @db.Timestamptz(3)
  offerExpiresAt DateTime?          @map("offer_expires_at") @db.Timestamptz(3)
  registeredAt   DateTime?          @map("registered_at") @db.Timestamptz(3)
  endedAt        DateTime?          @map("ended_at") @db.Timestamptz(3)
  idempotencyKey String?            @map("idempotency_key") @db.VarChar(100)
  /// Rule codes bypassed by an administrator (FR-ADMIN-022).
  overrides      String[]           @default([])
  overrideReason String?            @map("override_reason") @db.VarChar(500)
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  student  Student               @relation(fields: [studentId], references: [id])
  section  CourseSection         @relation(fields: [sectionId], references: [id])
  course   Course                @relation(fields: [courseId], references: [id])
  session  AcademicSession       @relation(fields: [sessionId], references: [id])
  events   RegistrationEvent[]
  requests RegistrationRequest[]

  finalGrade FinalGradeEntry?
  record     AcademicRecord?

  @@unique([studentId, idempotencyKey])
  @@index([sectionId, status])
  @@index([studentId, sessionId, status])
  @@index([sectionId, status, waitlistedAt, id])
  @@index([status, offerExpiresAt])
  @@map("course_registrations")
}

/// Append-only history of a registration (FR-REG-020).
model RegistrationEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  registrationId String              @map("registration_id") @db.Uuid
  fromStatus     RegistrationStatus? @map("from_status")
  toStatus       RegistrationStatus  @map("to_status")
  action         String              @db.VarChar(40)
  actorId        String?             @map("actor_id") @db.Uuid
  reason         String?             @db.VarChar(500)
  details        Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  registration CourseRegistration @relation(fields: [registrationId], references: [id])
  actor        User?              @relation(fields: [actorId], references: [id])

  @@index([registrationId, createdAt])
  @@map("registration_events")
}

/// Requests needing an administrator's decision (withdrawal when the policy requires approval).
model RegistrationRequest {
  id             String                  @id @default(uuid(7)) @db.Uuid
  registrationId String                  @map("registration_id") @db.Uuid
  type           RegistrationRequestType
  status         RequestStatus           @default(PENDING)
  reason         String?                 @db.VarChar(1000)
  decidedById    String?                 @map("decided_by_id") @db.Uuid
  decisionNote   String?                 @map("decision_note") @db.VarChar(500)
  decidedAt      DateTime?               @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  registration CourseRegistration @relation(fields: [registrationId], references: [id])
  decidedBy    User?              @relation("RequestDecider", fields: [decidedById], references: [id])

  @@index([status, createdAt])
  @@index([registrationId])
  @@map("registration_requests")
}

/// One completed course attempt (ADR-009): the source for prerequisites, progress and GPA.
model AcademicRecord {
  id                  String       @id @default(uuid(7)) @db.Uuid
  studentId           String       @map("student_id") @db.Uuid
  courseId            String       @map("course_id") @db.Uuid
  sessionId           String?      @map("session_id") @db.Uuid
  registrationId      String?      @unique @map("registration_id") @db.Uuid
  source              RecordSource
  courseCodeSnapshot  String       @map("course_code_snapshot") @db.VarChar(20)
  courseTitleSnapshot String       @map("course_title_snapshot") @db.VarChar(200)
  creditsAttempted    Decimal      @map("credits_attempted") @db.Decimal(4, 1)
  creditsEarned       Decimal      @map("credits_earned") @db.Decimal(4, 1)
  gradeLetter         String?      @map("grade_letter") @db.VarChar(5)
  gradePoints         Decimal?     @map("grade_points") @db.Decimal(4, 2)
  countsInGpa         Boolean      @default(true) @map("counts_in_gpa")
  passed              Boolean
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  student      Student             @relation(fields: [studentId], references: [id])
  course       Course              @relation(fields: [courseId], references: [id])
  session      AcademicSession?    @relation(fields: [sessionId], references: [id])
  registration CourseRegistration? @relation(fields: [registrationId], references: [id])
  gradeChanges GradeChange[]

  @@index([studentId, courseId])
  @@index([studentId, sessionId])
  @@map("academic_records")
}

model CoursePlan {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student          @relation(fields: [studentId], references: [id])
  session AcademicSession  @relation(fields: [sessionId], references: [id])
  items   CoursePlanItem[]

  @@unique([studentId, sessionId, name])
  @@map("course_plans")
}

model CoursePlanItem {
  planId    String  @map("plan_id") @db.Uuid
  courseId  String  @map("course_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid
  position  Int     @default(0) @db.SmallInt

  plan    CoursePlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id])
  section CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@id([planId, courseId])
  @@map("course_plan_items")
}

model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  title     String               @db.VarChar(200)
  body      String               @db.VarChar(2000)
  link      String?              @db.VarChar(500)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================================
// Faculty workspace (Phase 7): course materials and section announcements
// ============================================================================

enum MaterialKind {
  FILE
  LINK
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

/// Who an announcement is for (FR-COMM-008).
enum AudienceType {
  ALL_USERS
  ALL_STUDENTS
  ALL_FACULTY
  ALL_ADMINS
  USER
  SCHOOL
  DEPARTMENT
  PROGRAM
  SPECIALIZATION
  COURSE
  SECTION
  YEAR_OF_STUDY
}

/// Narrows organisational audiences (school, department, course, section) to students or faculty.
enum AudienceRole {
  ANY
  STUDENT
  FACULTY
}

/// Course material for a section (FR-FACULTY-007). Exactly one of fileId/url (CHECK in SQL).
model SectionMaterial {
  id          String       @id @default(uuid(7)) @db.Uuid
  sectionId   String       @map("section_id") @db.Uuid
  /// Grouping label shown to students, e.g. "Week 1" or "Labs".
  folder      String?      @db.VarChar(100)
  title       String       @db.VarChar(200)
  description String?      @db.VarChar(2000)
  kind        MaterialKind
  fileId      String?      @map("file_id") @db.Uuid
  url         String?      @db.VarChar(1000)
  position    Int          @default(0)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  file      StoredFile?   @relation(fields: [fileId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([sectionId, folder, position])
  @@map("section_materials")
}

/// Announcements (FR-COMM-008). Phase 7 publishes to sections; more audiences arrive in Phase 9.
model Announcement {
  id          String               @id @default(uuid(7)) @db.Uuid
  authorId    String               @map("author_id") @db.Uuid
  title       String               @db.VarChar(200)
  body        String               @db.Text
  priority    AnnouncementPriority @default(NORMAL)
  pinned      Boolean              @default(false)
  /// Publish time; a future value schedules the announcement (FR-COMM-010).
  publishedAt DateTime             @default(now()) @map("published_at") @db.Timestamptz(3)
  expiresAt   DateTime?            @map("expires_at") @db.Timestamptz(3)
  /// Set once the notification fan-out has run (FR-COMM-009).
  notifiedAt  DateTime?            @map("notified_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  author    User                   @relation(fields: [authorId], references: [id])
  audiences AnnouncementAudience[]
  reads     AnnouncementRead[]

  @@index([authorId, publishedAt])
  @@index([publishedAt])
  @@index([expiresAt])
  @@map("announcements")
}

model AnnouncementAudience {
  id             String       @id @default(uuid(7)) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  targetType     AudienceType @map("target_type")
  /// User, school, department, program, specialization, course or section id; null for ALL_* audiences.
  targetId       String?      @map("target_id") @db.Uuid
  /// Year of study for YEAR_OF_STUDY (optionally narrowed to the department in target_id).
  targetValue    Int?         @map("target_value") @db.SmallInt
  roleFilter     AudienceRole @default(ANY) @map("role_filter")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([targetType, targetId])
  @@map("announcement_audiences")
}

model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ============================================================
// Phase 9 — communication (DATABASE.md §3.8)
// ============================================================

enum ConversationType {
  DIRECT
  SECTION
  SUPPORT
}

enum ParticipantRole {
  MEMBER
  MODERATOR
}

/// A message thread (FR-COMM-001/003). DIRECT: one per user pair (`direct_key`);
/// SECTION: one per course section; SUPPORT: one per user, answered by administrators.
model Conversation {
  id               String           @id @default(uuid(7)) @db.Uuid
  type             ConversationType
  sectionId        String?          @unique @map("section_id") @db.Uuid
  /// Sorted "userA:userB" pair for DIRECT conversations.
  directKey        String?          @unique @map("direct_key") @db.VarChar(80)
  /// The user a SUPPORT conversation belongs to.
  supportOwnerId   String?          @unique @map("support_owner_id") @db.Uuid
  announcementOnly Boolean          @default(false) @map("announcement_only")
  lastMessageAt    DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdById      String           @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  section      CourseSection?            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  supportOwner User?                     @relation("SupportOwner", fields: [supportOwnerId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([type, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId    String          @map("conversation_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  role              ParticipantRole @default(MEMBER)
  lastReadMessageId String?         @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime?       @map("last_read_at") @db.Timestamptz(3)
  joinedAt          DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt            DateTime?       @map("left_at") @db.Timestamptz(3)
  muted             Boolean         @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_participants")
}

model Message {
  id             String                   @id @default(uuid(7)) @db.Uuid
  conversationId String                   @map("conversation_id") @db.Uuid
  senderId       String                   @map("sender_id") @db.Uuid
  body           String                   @db.Text
  editedAt       DateTime?                @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  searchVector   Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id])
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([searchVector], type: Gin, map: "messages_search_vector")
  @@map("messages")
}

model MessageAttachment {
  messageId String @map("message_id") @db.Uuid
  fileId    String @unique @map("file_id") @db.Uuid

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id])

  @@id([messageId, fileId])
  @@map("message_attachments")
}

enum DiscussionThreadType {
  QUESTION
  DISCUSSION
}

/// Section Q&A (FR-COMM-007).
model DiscussionThread {
  id             String               @id @default(uuid(7)) @db.Uuid
  sectionId      String               @map("section_id") @db.Uuid
  authorId       String               @map("author_id") @db.Uuid
  type           DiscussionThreadType @default(DISCUSSION)
  title          String               @db.VarChar(200)
  body           String               @db.Text
  pinned         Boolean              @default(false)
  locked         Boolean              @default(false)
  answerPostId   String?              @unique @map("answer_post_id") @db.Uuid
  replyCount     Int                  @default(0) @map("reply_count")
  lastActivityAt DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  editedAt       DateTime?            @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  section    CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id])
  answerPost DiscussionPost?  @relation("ThreadAnswer", fields: [answerPostId], references: [id], onDelete: SetNull)
  posts      DiscussionPost[] @relation("ThreadPosts")

  @@index([sectionId, lastActivityAt(sort: Desc)])
  @@map("discussion_threads")
}

model DiscussionPost {
  id        String    @id @default(uuid(7)) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String    @db.Text
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  thread   DiscussionThread  @relation("ThreadPosts", fields: [threadId], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [authorId], references: [id])
  answerOf DiscussionThread? @relation("ThreadAnswer")

  @@index([threadId, createdAt])
  @@map("discussion_posts")
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// Opt-outs and opt-ins per category and channel (FR-NOTIF-004); missing rows use defaults.
model NotificationPreference {
  userId   String               @map("user_id") @db.Uuid
  category NotificationCategory
  channel  NotificationChannel
  enabled  Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Outbound email attempts (FR-NOTIF-005).
model EmailLog {
  id        String      @id @default(uuid(7)) @db.Uuid
  toAddress String      @map("to_address") @db.VarChar(254)
  subject   String      @db.VarChar(300)
  kind      String      @db.VarChar(60)
  status    EmailStatus @default(QUEUED)
  attempts  Int         @default(0)
  lastError String?     @map("last_error") @db.VarChar(1000)
  sentAt    DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("email_logs")
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeedbackCategory {
  ACADEMIC
  COURSE
  FACULTY
  REGISTRATION
  FACILITIES
  TECHNICAL
  ADMINISTRATIVE
  OTHER
}

enum FeedbackStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// FR-COMM-012.
model Feedback {
  id             String           @id @default(uuid(7)) @db.Uuid
  submittedById  String           @map("submitted_by_id") @db.Uuid
  /// Hides the submitter from everyone but super administrators.
  anonymous      Boolean          @default(false)
  category       FeedbackCategory
  subject        String           @db.VarChar(200)
  description    String           @db.Text
  departmentId   String?          @map("department_id") @db.Uuid
  courseId       String?          @map("course_id") @db.Uuid
  priority       CasePriority     @default(MEDIUM)
  status         FeedbackStatus   @default(OPEN)
  assigneeId     String?          @map("assignee_id") @db.Uuid
  resolutionNote String?          @map("resolution_note") @db.Text
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  submittedBy User               @relation("FeedbackSubmitter", fields: [submittedById], references: [id])
  assignee    User?              @relation("FeedbackAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  responses   FeedbackResponse[]

  @@index([status, priority])
  @@index([submittedById])
  @@index([departmentId, status])
  @@map("feedback")
}

model FeedbackResponse {
  id         String   @id @default(uuid(7)) @db.Uuid
  feedbackId String   @map("feedback_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([feedbackId, createdAt])
  @@map("feedback_responses")
}

enum TicketCategory {
  REGISTRATION
  ACADEMIC
  FACULTY
  TECHNICAL
  ACCOUNT
  DEPARTMENT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  REOPENED
}

/// FR-COMM-013/014.
model SupportTicket {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// TCK-YYYY-000123, backed by id_sequences.
  ticketNumber   String         @unique @map("ticket_number") @db.VarChar(20)
  ownerId        String         @map("owner_id") @db.Uuid
  /// Owner's department at submission; decides which administrators see the ticket.
  departmentId   String?        @map("department_id") @db.Uuid
  category       TicketCategory
  priority       CasePriority   @default(MEDIUM)
  subject        String         @db.VarChar(200)
  description    String         @db.Text
  status         TicketStatus   @default(OPEN)
  assigneeId     String?        @map("assignee_id") @db.Uuid
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(3)
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz(3)
  lastActivityAt DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User               @relation("TicketOwner", fields: [ownerId], references: [id])
  assignee    User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  responses   TicketResponse[]
  events      TicketEvent[]
  attachments TicketAttachment[]

  @@index([status, assigneeId])
  @@index([ownerId])
  @@index([departmentId, status])
  @@map("support_tickets")
}

model TicketResponse {
  id        String   @id @default(uuid(7)) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  /// Internal notes are never shown to the ticket owner.
  internal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_responses")
}

model TicketEvent {
  id        String          @id @default(uuid(7)) @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  actorId   String?         @map("actor_id") @db.Uuid
  type      TicketEventType
  fromValue String?         @map("from_value") @db.VarChar(60)
  toValue   String?         @map("to_value") @db.VarChar(60)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model TicketAttachment {
  id         String   @id @default(uuid(7)) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  /// Null when attached to the ticket itself.
  responseId String?  @map("response_id") @db.Uuid
  fileId     String   @unique @map("file_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket   SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  response TicketResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  file     StoredFile      @relation(fields: [fileId], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

// ============================================================
// Phase 10 — academic management (DATABASE.md §3.7)
// ============================================================

enum GpaRepeatPolicy {
  /// Every attempt counts.
  ALL
  /// Only the most recent attempt at a course counts.
  LATEST
  /// Only the best attempt at a course counts.
  BEST
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One class meeting on a date for which attendance is taken (FR-ACAD-003).
model AttendanceSession {
  id          String   @id @default(uuid(7)) @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  date        DateTime @db.Date
  startMinute Int?     @map("start_minute") @db.SmallInt
  topic       String?  @db.VarChar(200)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  section   CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id])
  records   AttendanceRecord[]

  @@unique([sectionId, date, startMinute])
  @@index([sectionId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  attendanceSessionId String           @map("attendance_session_id") @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  status              AttendanceStatus
  note                String?          @db.VarChar(300)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  session           AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id])
  academicSession   AcademicSession?  @relation(fields: [academicSessionId], references: [id])
  academicSessionId String?           @db.Uuid

  @@id([attendanceSessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

enum AssessmentType {
  ASSIGNMENT
  QUIZ
  EXAM
  PROJECT
  LAB
  OTHER
}

/// A graded component of a section (FR-ACAD-004); weights total 100 % at grade submission.
model Assessment {
  id          String         @id @default(uuid(7)) @db.Uuid
  sectionId   String         @map("section_id") @db.Uuid
  title       String         @db.VarChar(200)
  type        AssessmentType
  weight      Decimal        @db.Decimal(5, 2)
  maxScore    Decimal        @map("max_score") @db.Decimal(6, 2)
  dueAt       DateTime?      @map("due_at") @db.Timestamptz(3)
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(3)
  position    Int            @default(0) @db.SmallInt
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  section CourseSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  scores  AssessmentScore[]

  @@index([sectionId, position])
  @@map("assessments")
}

model AssessmentScore {
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  /// Null with `excused` = excused from this component (excluded from the computed mark).
  score        Decimal? @db.Decimal(6, 2)
  excused      Boolean  @default(false)
  feedback     String?  @db.VarChar(1000)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assessment        Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id])
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  academicSessionId String?          @db.Uuid

  @@id([assessmentId, studentId])
  @@index([studentId])
  @@map("assessment_scores")
}

enum GradeSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  POSTED
}

/// Section-level final grade workflow (FR-ACAD-006): instructor drafts and submits,
/// an administrator approves (posting the grades) or returns it.
model FinalGradeSubmission {
  id            String                @id @default(uuid(7)) @db.Uuid
  sectionId     String                @unique @map("section_id") @db.Uuid
  status        GradeSubmissionStatus @default(DRAFT)
  submittedById String?               @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz(3)
  decidedById   String?               @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz(3)
  returnReason  String?               @map("return_reason") @db.VarChar(1000)
  postedAt      DateTime?             @map("posted_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  section     CourseSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submittedBy User?             @relation("GradeSubmitter", fields: [submittedById], references: [id])
  decidedBy   User?             @relation("GradeDecider", fields: [decidedById], references: [id])
  entries     FinalGradeEntry[]

  @@index([status])
  @@map("final_grade_submissions")
}

model FinalGradeEntry {
  registrationId String   @id @map("registration_id") @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  gradeLetter    String   @map("grade_letter") @db.VarChar(5)
  /// Computed mark when the instructor entered it (informational).
  percent        Decimal? @db.Decimal(5, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration CourseRegistration   @relation(fields: [registrationId], references: [id])
  submission   FinalGradeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("final_grade_entries")
}

/// Versioned history of posted-grade changes (FR-ACAD-006/009).
model GradeChange {
  id               String   @id @default(uuid(7)) @db.Uuid
  academicRecordId String   @map("academic_record_id") @db.Uuid
  version          Int
  fromLetter       String?  @map("from_letter") @db.VarChar(5)
  toLetter         String   @map("to_letter") @db.VarChar(5)
  fromPoints       Decimal? @map("from_points") @db.Decimal(4, 2)
  toPoints         Decimal? @map("to_points") @db.Decimal(4, 2)
  reason           String   @db.VarChar(1000)
  changedById      String   @map("changed_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  record    AcademicRecord @relation(fields: [academicRecordId], references: [id])
  changedBy User           @relation(fields: [changedById], references: [id])

  @@unique([academicRecordId, version])
  @@map("grade_changes")
}

// ============================================================
// Phase 11 — reporting (DATABASE.md §3.9)
// ============================================================

enum ExportFormat {
  CSV
  XLSX
}

enum ExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// A report export (FR-RPT-003); large ones run on the `exports` queue.
model ExportJob {
  id            String       @id @default(uuid(7)) @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  reportKey     String       @map("report_key") @db.VarChar(60)
  format        ExportFormat
  /// Filters and sort as submitted (validated against the report on run).
  params        Json
  status        ExportStatus @default(QUEUED)
  rowCount      Int?         @map("row_count")
  fileId        String?      @unique @map("file_id") @db.Uuid
  error         String?      @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)

  requestedBy User        @relation(fields: [requestedById], references: [id])
  file        StoredFile? @relation(fields: [fileId], references: [id])

  @@index([requestedById, createdAt(sort: Desc)])
  @@index([status])
  @@map("export_jobs")
}
